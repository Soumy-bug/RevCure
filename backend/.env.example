# ==============================================================================
# RevCure - Backend Application Environment Template
# Copy this file to backend/.env and fill in the required secrets.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True

# Database Connection URL (psycopg3 / SQLAlchemy)
DATABASE_URL=postgresql+psycopg://POSTGRES_USER:POSTGRES_PASSWORD@localhost:5432/POSTGRES_DB

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Authentication / Security
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
