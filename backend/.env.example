# Application Environment
ENVIRONMENT=development
DEBUG=true
ENABLE_DB_TEST=false

# Database Connection URL (asyncpg dialect)
DATABASE_URL=postgresql+asyncpg://revcure_user:postgres@localhost:5433/revcure_db

# ── Razorpay (Test Mode) ────────────────────────────────────────────────────
# Obtain test credentials from https://dashboard.razorpay.com/app/keys
# The app checks for non-placeholder values; leave blank or use the exact
# placeholder strings below to run WITHOUT Razorpay (demo mode).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Razorpay (Test Mode — filled) ───────────────────────────────────────────
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
