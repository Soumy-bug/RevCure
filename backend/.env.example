# ==============================================================================
# RevCure - Backend Application Environment Template
# Copy this file to backend/.env and fill in the required secrets.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
ENABLE_DB_TEST=false

# Database Connection URL (SQLAlchemy + asyncpg)
DATABASE_URL=postgresql+asyncpg://POSTGRES_USER:POSTGRES_PASSWORD@localhost:5433/POSTGRES_DB

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Authentication / Security
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
